{
  "name": "bomba-lt-tests",
  "version": "1.0.0",
  "description": "E2E tests for bomba.lt (PrestaShop 9.1.1) — read-only smoke against production",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test specs/smoke",
    "test:visual": "playwright test specs/visual",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:update-snapshots": "playwright test --update-snapshots",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@axe-core/playwright": "^4.10.0"
  }
}
